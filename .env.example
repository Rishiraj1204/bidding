# ==============================================================================
# BIDVERIFY Platform Environment Configuration (.env.example)
# SIH Problem Statement ID: 26100
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# Backend Settings
PROJECT_NAME="BIDVERIFY — AI-Powered Bid Compliance Verification Platform"
PROJECT_VERSION=0.1.0
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bidverify_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bidverify_db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage Configuration
STORAGE_LOCAL_DIR=./storage_data
MAX_UPLOAD_SIZE_BYTES=52428800

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
